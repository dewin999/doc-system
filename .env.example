# ---------- Supabase (Postgres) ----------
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (พอร์ต 6543)
# ใส่รหัสผ่านฐานข้อมูลแทน [YOUR-PASSWORD]
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ---------- ความปลอดภัย ----------
# สุ่มยาวอย่างน้อย 32 ตัว เช่น รัน: openssl rand -hex 32
SESSION_SECRET=

# ---------- Google Drive (ผ่าน Apps Script gateway) ----------
# URL ของ Web app ที่ deploy จาก apps-script/DriveGateway.gs (ลงท้ายด้วย /exec)
DRIVE_GATEWAY_URL=https://script.google.com/macros/s/xxxxxxxx/exec
# ค่าเดียวกับ Script Property "GATEWAY_SECRET" ของสคริปต์นั้น
DRIVE_GATEWAY_SECRET=
